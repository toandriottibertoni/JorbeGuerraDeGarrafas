# Copie para .env e preencha.

# Porta do servidor Node (HTTP + WebSocket + front em producao)
PORT=3000

# MongoDB Atlas (free tier M0). Formato:
# mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Deixe vazio para rodar sem banco (modo offline: sem cadastro/ranking).
MONGODB_URI=

# Nome do banco dentro do cluster
MONGODB_DB=guerra_de_garrafas

# Segredo para assinar os tokens de sessao. Gere um valor longo e aleatorio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origem permitida em desenvolvimento (Vite)
CLIENT_ORIGIN=http://localhost:5173
